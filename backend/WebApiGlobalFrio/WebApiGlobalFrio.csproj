<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <!-- Smart App Control (Windows) bloquea un .dll idéntico al recompilar; así cada compilación genera uno nuevo. -->
    <Deterministic>false</Deterministic>
    <!-- Smart App Control bloquea el .exe que genera .NET; sin él, dotnet run inicia la API con "dotnet WebApiGlobalFrio.dll". -->
    <UseAppHost>false</UseAppHost>
    <!-- Si la PC tiene una versión de .NET más nueva que la 8, la API corre igual con esa versión. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="12.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DTO\DTO.csproj" />
    <ProjectReference Include="..\Entity\Entity.csproj" />
    <ProjectReference Include="..\Data\Data.csproj" />
    <ProjectReference Include="..\Service\Service.csproj" />
  </ItemGroup>

  <!-- Script de la base de datos: se copia junto al ejecutable para crear la BD al iniciar si no existe. -->
  <ItemGroup>
    <None Include="..\..\database\BD_GLOBALFRIO.sql" Link="database\BD_GLOBALFRIO.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
